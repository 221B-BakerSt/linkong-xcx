{
    "compilerOptions": {
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "dist/compiled",
        "allowJs": true,
        "lib": ["es2017", "dom", "esnext"],
        "baseUrl": "./",
        "paths": {
            "@": [
                "src"
            ],
            "@/*": [
                "src/*"
            ],
            "vue": ["node_modules/vue"]
        },
        "esModuleInterop": true
    },
    "exclude": [
        "node_modules"
    ]
}